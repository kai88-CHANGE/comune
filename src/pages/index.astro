---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/ui';

const lang = 'ja';
const t = useTranslations(lang);

const all = await getCollection('articles');
const articles = all.filter(a => a.data.lang === 'ja').sort((a, b) => b.data.issue - a.data.issue);

const categories = [
  { key: '生徒会論', desc: t('cat.desc.seitokai') },
  { key: '学校教育論', desc: t('cat.desc.kyoiku') },
  { key: '自治の境界線', desc: t('cat.desc.jichi') },
];
---

<Layout lang={lang}>
  <div class="max-w-4xl mx-auto px-6">

    <!-- 最新記事 -->
    <section class="pt-14 pb-12">
      <div class="flex items-center gap-4 mb-10">
        <span class="text-[10px] tracking-[0.3em] text-[var(--muted)] uppercase">{t('section.latest')}</span>
        <span class="flex-1 h-px bg-[var(--rule)]"></span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-0">
        {articles.slice(0, 3).map((article, i) => (
          <article class={`py-6 ${i < 2 ? 'sm:pr-8 sm:border-r border-[var(--rule)]' : ''} ${i > 0 ? 'sm:pl-8' : ''} ${i > 0 ? 'border-t sm:border-t-0 border-[var(--rule)]' : ''}`}>
            <div class="serif text-4xl font-bold text-[var(--rule)] mb-3 leading-none">
              {String(article.data.issue).padStart(2, '0')}
            </div>
            <div class="text-xs text-[var(--muted)] mb-2">{article.data.category}</div>
            <h2 class="serif text-base font-medium leading-snug mb-3">
              <a href={`/articles/${article.id}`} class="hover:text-[var(--accent)] transition-colors">
                {article.data.title}
              </a>
            </h2>
            <p class="text-xs text-[var(--muted)] leading-relaxed">{article.data.summary}</p>
            <time class="block text-[10px] text-[var(--rule)] mt-3 tracking-wider" datetime={article.data.date.toISOString()}>
              {article.data.date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </article>
        ))}
      </div>

      {articles.length > 3 && (
        <div class="mt-10 text-right">
          <a href="/articles" class="text-xs text-[var(--muted)] hover:text-[var(--ink)] transition-colors tracking-wider">
            {t('articles.readMore')}
          </a>
        </div>
      )}
    </section>

    <!-- 区切り -->
    <div class="border-t-2 border-[var(--ink)]"></div>

    <!-- カテゴリ -->
    <section class="py-12">
      <div class="flex items-center gap-4 mb-10">
        <span class="text-[10px] tracking-[0.3em] text-[var(--muted)] uppercase">{t('section.categories')}</span>
        <span class="flex-1 h-px bg-[var(--rule)]"></span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-0">
        {categories.map((cat, i) => {
          const count = articles.filter(a => a.data.category === cat.key).length;
          return (
            <a
              href={`/articles?category=${encodeURIComponent(cat.key)}`}
              class={`group py-6 ${i < 2 ? 'sm:pr-8 sm:border-r border-[var(--rule)]' : ''} ${i > 0 ? 'sm:pl-8' : ''} ${i > 0 ? 'border-t sm:border-t-0 border-[var(--rule)]' : ''}`}
            >
              <h3 class="serif text-lg font-bold mb-2 group-hover:text-[var(--accent)] transition-colors">{cat.key}</h3>
              <p class="text-xs text-[var(--muted)] leading-relaxed mb-3">{cat.desc}</p>
              <span class="text-xs text-[var(--rule)]">{count}{t('articles.count')}</span>
            </a>
          );
        })}
      </div>
    </section>

  </div>
</Layout>
