---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/ui';

const lang = 'ja';
const t = useTranslations(lang);

const issues = [
  {
    id: 'approval',
    topic: '企画の審査・承認権',
    status: '学校側が事前審査。拒否の基準は不明確なことが多い',
    position: '明文化された基準に違反しない限り、学校側は承認権を持つべきでない',
    axis: { x: 30, y: 25 },
    articles: ['ja/sokan'],
  },
  {
    id: 'eligibility',
    topic: '被選挙資格',
    status: '成績・懲戒歴を条件とする学校が多い',
    position: '成績・懲戒歴による制限は正当性を欠く',
    axis: { x: 20, y: 60 },
    articles: ['ja/senkyo-shikaku'],
  },
  {
    id: 'speech',
    topic: '学校批判の言論の自由',
    status: '批判が「不適切」として指導の対象になることがある',
    position: '制度を対象とした批判は原則として保護される',
    axis: { x: 65, y: 40 },
    articles: ['ja/genron-jiyu'],
  },
  {
    id: 'budget',
    topic: '予算の配分権限',
    status: '生徒会費の配分は学校承認が前提',
    position: '一定額以下は生徒会の議決のみで執行できるべき',
    axis: { x: 50, y: 70 },
    articles: [],
  },
  {
    id: 'rules',
    topic: '校則の改廃決定権',
    status: '学校側が制定・改廃を決定。生徒会は提案のみ',
    position: '改廃の議決権を生徒会が持つべき',
    axis: { x: 75, y: 20 },
    articles: [],
  },
];
---

<Layout title={t('issues.title')} lang={lang}>
  <div class="max-w-4xl mx-auto px-6 py-14">

    <div class="flex items-center gap-4 mb-4">
      <h2 class="serif text-2xl font-bold">{t('issues.title')}</h2>
      <span class="flex-1 h-px bg-[var(--rule)]"></span>
    </div>
    <p class="text-sm text-[var(--muted)] mb-12">{t('issues.desc')}</p>

    <!-- ビジュアルマップ -->
    <div class="border border-[var(--rule)] mb-14 relative" style="height: 320px; background: repeating-linear-gradient(0deg, transparent, transparent 39px, var(--rule) 39px, var(--rule) 40px), repeating-linear-gradient(90deg, transparent, transparent 39px, var(--rule) 39px, var(--rule) 40px); background-color: color-mix(in srgb, var(--paper) 98%, var(--ink));">
      <!-- 軸ラベル -->
      <div class="absolute bottom-2 left-1/2 -translate-x-1/2 text-[9px] text-[var(--muted)] tracking-widest uppercase">制度的権限（低 → 高）</div>
      <div class="absolute left-2 top-1/2 -translate-y-1/2 text-[9px] text-[var(--muted)] tracking-widest uppercase" style="writing-mode: vertical-rl; transform: translateY(-50%) rotate(180deg);">緊急度（低 → 高）</div>

      {issues.map((issue) => (
        <a
          href={`#${issue.id}`}
          class="absolute group"
          style={`left: ${issue.axis.x}%; top: ${issue.axis.y}%; transform: translate(-50%, -50%)`}
        >
          <div class={`w-3 h-3 rounded-full border-2 transition-all group-hover:scale-150 ${issue.articles.length > 0 ? 'bg-[var(--accent)] border-[var(--accent)]' : 'bg-[var(--paper)] border-[var(--ink)]'}`}></div>
          <span class="absolute left-4 top-0 text-[10px] whitespace-nowrap text-[var(--ink)] font-medium hidden group-hover:block bg-[var(--paper)] px-1 border border-[var(--rule)]">
            {issue.topic}
          </span>
        </a>
      ))}
    </div>
    <div class="flex gap-4 text-xs text-[var(--muted)] mb-14">
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[var(--accent)] inline-block"></span>記事あり</span>
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full border-2 border-[var(--ink)] inline-block"></span>記事なし（今後執筆予定）</span>
    </div>

    <!-- テーブル -->
    <div class="space-y-0">
      {issues.map((issue) => (
        <div id={issue.id} class="border-b border-[var(--rule)] py-8 grid grid-cols-1 sm:grid-cols-[1fr_1fr] gap-x-8 gap-y-3">
          <div>
            <h3 class="serif text-base font-bold mb-3">{issue.topic}</h3>
            <p class="text-xs text-[var(--muted)] uppercase tracking-wider mb-1">{t('issues.current')}</p>
            <p class="text-sm leading-relaxed">{issue.status}</p>
          </div>
          <div>
            <p class="text-xs text-[var(--muted)] uppercase tracking-wider mb-1 sm:mt-7">{t('issues.position')}</p>
            <p class="text-sm leading-relaxed mb-3">{issue.position}</p>
            {issue.articles.length > 0 && (
              <div>
                <p class="text-xs text-[var(--muted)] mb-1">{t('issues.related')}</p>
                <div class="flex flex-wrap gap-2">
                  {issue.articles.map((slug: string) => (
                    <a href={`/articles/${slug.replace('ja/', '')}`}
                       class="text-xs text-[var(--accent)] border border-[var(--rule)] px-2 py-0.5 hover:border-[var(--accent)] transition-colors">
                      {t('issues.read')}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    <p class="text-xs text-[var(--muted)] mt-10">{t('issues.note')}</p>
  </div>
</Layout>
